{
  "info": {
    "name": "HomeStore API",
    "_postman_id": "homestore-api-collection",
    "description": "Endpoints REST del sistema HomeStore - Proyecto Final SC-403",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },

  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8081",
      "type": "string"
    }
  ],

  "item": [
    {
      "name": "GET /api/productos (listar)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/productos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        },
        "description": "Lista los productos registrados en HomeStore."
      }
    },

    {
      "name": "POST /api/productos (crear)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Lampara de escritorio\",\n  \"description\": \"Lampara LED para escritorio\",\n  \"price\": 18000.00,\n  \"costPrice\": 12000.00,\n  \"stock\": 15\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/productos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "productos"
          ]
        },
        "description": "Crea un nuevo producto en HomeStore."
      }
    }
  ]
}
